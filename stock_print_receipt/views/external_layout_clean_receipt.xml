<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="external_layout_clean_receipt">
    <div style="width:78mm; font-size:16px; line-height:1.2; padding:0; margin:0 auto;">

      <!-- Header con logo -->
      <div class="text-center" style="margin-bottom: 4mm;">
        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-width: 200px; height: auto; margin-bottom: 20px;" alt="Logo"/>
        <div style="font-weight:bold;" t-if="company.name" t-field="company.name"/>
        <div t-if="company.vat">
          <t t-esc="company.country_id.vat_label or 'Tax ID'"/>: <span t-field="company.vat"/>
        </div>
        <div t-if="company.phone">Tel: <span t-field="company.phone"/></div>
        <div t-if="company.email"><span t-field="company.email"/></div>
      </div>

      <!-- Datos del cliente -->
      <div class="mt-2 mb-2">
        <t t-if="o.partner_id">
          <strong>Cliente:</strong> <span style="font-weight:bold;" t-field="o.partner_id.name"/><br/>
          <t t-if="o.partner_id.vat">
            <strong>CC/NIT:</strong> <span t-field="o.partner_id.vat"/><br/>
          </t>
          <t t-if="o.partner_id.street">
            <strong>Dirección:</strong> <span t-field="o.partner_id.street"/>
            <t t-if="o.partner_id.street2">, <span t-field="o.partner_id.street2"/></t><br/>
            <t t-if="o.partner_id.city"><span t-field="o.partner_id.city"/></t>
            <t t-if="o.partner_id.state_id">, <span t-field="o.partner_id.state_id.name"/></t>
            <t t-if="o.partner_id.zip"> <span t-field="o.partner_id.zip"/></t><br/>
          </t>
          <t t-if="o.partner_id.phone"><strong>Tel: </strong><span t-field="o.partner_id.phone"/></t>
          <t t-if="o.partner_id.mobile"><strong>Cel: </strong><span t-field="o.partner_id.mobile"/></t>
        </t>
      </div>



      <!-- Cuerpo del reporte -->
      <div t-att-data-oe-model="o and o._name"
           t-att-data-oe-id="o and o.id"
           t-att-data-oe-lang="o and o.env.context.get('lang')">
        <t t-raw="0"/>
      </div>

      <!-- Datos logísticos -->
      <t t-if="o.volume or o.weight">
        <div>
          <div t-if="o.volume">
            <strong>Volumen:</strong> <span t-field="o.volume"/> <span t-field="o.volume_uom_name"/>
          </div>
          <div t-if="o.weight">
            <strong>Peso:</strong> <span t-field="o.weight"/> <span t-field="o.weight_uom_name"/>
          </div>
        </div>
      </t>
      
      <!-- Datos Domiciliario -->
      <t t-if="o.user_id.name">
        <div>
            <strong>Responsable Entrega:</strong> <span t-field="o.user_id.name"/> 
        </div>
      </t>

      <!-- Notas -->
      <t t-if="o.note">
        <div style="margin-top: 20px;">
            <strong>Notas:</strong> <span t-field="o.note"/> 
        </div>
      </t>

      <!-- Pie de página reducido -->
      <div class="text-center" style="margin-top:6mm; font-size:9px;" t-if="company.report_footer">
        <span t-field="company.report_footer"/>
      </div>

    </div>
  </template>
</odoo>
