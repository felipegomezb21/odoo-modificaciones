<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_delivery_document_receipt">
        <t t-call="web.html_container">
        <t t-call="stock_print_receipt.external_layout_receipt">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
            <style>
            .thermal-receipt {
                font-size: 10px;
                line-height: 1.2;
                width: 72mm;
                margin: 0 auto;
            }
            .receipt-table th,
            .receipt-table td {
                padding: 2px 0;
            }
            .receipt-table th {
                font-weight: bold;
                border-bottom: 1px dashed #000;
            }
            .company_logo img {
                max-width: 200px; /* Asegura que el logo no sea más ancho que el papel */
                height: auto;
            }
            </style>
            <div class="thermal-receipt">
                <h3 style="text-align: center;">
                    <span t-field="o.name"/>
                </h3>
                <div>
                    <t t-if="o.origin">
                        <strong>Order:</strong>
                        <span t-field="o.origin"/>
                    </t><br/>
                    <t t-if="o.state">
                        <strong>Shipping Date:</strong>
                        <t t-if="o.state == 'done'">
                            <span t-field="o.date_done"/>
                        </t>
                        <t t-if="o.state != 'done'">
                            <span t-field="o.scheduled_date"/>
                        </t>
                    </t>
                </div>
                <br/>
                <table class="receipt-table" style="width: 100%;">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th style="text-align: right;">Qty</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="lines" t-value="o.move_lines.filtered(lambda x: x.product_uom_qty)"/>
                        <tr t-foreach="lines" t-as="move">
                            <td>
                                <span t-field="move.product_id"/>
                            </td>
                            <td style="text-align: right;">
                                <span t-field="move.product_uom_qty"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <br/>
                <div t-if="o.signature">
                    <strong>Signature:</strong><br/>
                    <img t-att-src="image_data_uri(o.signature)" style="max-height: 80px; max-width: 100%;"/>
                    <p style="text-align: center;" t-field="o.partner_id.name"/>
                </div>
            </div>
        </t>
        </t>
    </template>
</odoo>