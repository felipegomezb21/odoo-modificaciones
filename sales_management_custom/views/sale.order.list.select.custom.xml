<?xml version="1.0" encoding="utf-8" ?>
<odoo>  
    <record id="sale_order_list_select_custom" model="ir.ui.view">
        <field name="name">sale.view_sales_order_filter.custom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter" />
        <field name="arch" type="xml">
            <!-- Filter by tags -->
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <separator/>
                <filter name="distributor" string="Distributor" domain="[['partner_id.category_id.name','=','Distribuidor']]"/>
                <filter name="TaT" string="TaT" domain="[['partner_id.category_id.name','=','Tienda a Tienda']]"/>
                <filter name="maquila" string="Maquila" domain="[['partner_id.category_id.name','=','Maquila']]"/>
                <filter name="direct_customer" string="Direct Customer" domain="['|', ('partner_id.category_id','=',False), ('partner_id.category_id.name','not in',['Distribuidor', 'Maquila', 'Tienda a Tienda'])]"/>
             </xpath>
        </field>
    </record>
</odoo>