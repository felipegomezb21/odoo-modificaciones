    <!-- Vista formulario para el tablero -->
    <record id="custom_dashboard_form_sales_view" model="ir.ui.view">
        <field name="name">Indicadores Ventas</field>
        <field name="model">board.board</field>
        <field name="arch" type="xml">
            <form string="Custom Sales Dashboard">
                    <board style="1"> <!-- Define el diseño de columnas -->
                        <!-- Primera columna -->
                        <column>
                            <!-- <action name="action_facturado_mes_vs_mes_anterior_custom" string="Facturado Mes vs Mes Anterior" view_mode="graph"/> -->
                        </column>
                    </board>
            </form>
        </field>
    </record>

    <!-- Acción para el tablero -->
    <record id="action_custom_sales_dashboard" model="ir.actions.act_window">
        <field name="name">Custom Sales Dashboard</field>
        <field name="res_model">board.board</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="custom_dashboard_form_sales_view"/>
        <field name="target">current</field>
    </record>

    <!-- Menú para acceder al tablero -->
    <menuitem id="menu_custom_sales_dashboard" name="Indicadores Ventas"
              action="dashboard_custom.action_custom_sales_dashboard"
              parent="base.menu_board_root" sequence="10"/>
