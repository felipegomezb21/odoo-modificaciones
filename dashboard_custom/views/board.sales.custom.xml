<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="dboard.sales_custom" model="ir.ui.view">
        <field name="name">Indicadores Ventas</field>
        <field name="model">board.board</field>
        <field name="arch" type="xml">
            <dashboard>
                <board>
                    <column>
                        <field name="name" widget="statinfo" options="{'icon': 'fa-users'}"/>
                    </column>
                    <column>
                        <field name="name" widget="statinfo" options="{'icon': 'fa-cogs'}"/>
                    </column>
                </board>
            </dashboard>
        </field>
    </record>

    <record id="action_board_sales_custom" model="ir.actions.act_window">
        <field name="name">Indicadores Ventas</field>
        <field name="res_model">board.board</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_board_sales_custom"/>
        <field name="target">self</field>
    </record>

    <menuitem id="menu_board_sales_custom" name="Indicadores Ventas" action="action_board_sales_custom" sequence="1"/>
</odoo>

