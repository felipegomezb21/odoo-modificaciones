<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form - Add percentage product button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <field name="state" position="before">
                <button
                    name="add_percentage_product"
                    class="ml-2 btn btn-default"
                    string="Add percentage product"
                    Help="add a product with a percentage from total order"
                    type="object"
                    attrs="{'invisible':[('state','not in', ['draft', 'sent'])]}"
                />
            </field>
        </field>
    </record>
</odoo>
